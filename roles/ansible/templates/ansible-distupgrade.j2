# run ubuntu dist-upgrade via ansible-pull
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

echo "Preparing... "
/usr/bin/nice /usr/bin/ansible-pull --full -d /etc/ansible/ring -U https://github.com/NLNOG/ring-ansible.git --vault-password-file=/root/.vaultpw -i nodes -l {{ ansible_facts['nodename'] }} -c local --tags prepare ubuntu_upgrade.yml

echo "Reconfiguring sshd (for resolute)... "
/usr/bin/nice /usr/bin/ansible-pull --full -d /etc/ansible/ring -U https://github.com/NLNOG/ring-ansible.git --vault-password-file=/root/.vaultpw -i nodes -l {{ ansible_facts['nodename'] }} -c local --tags openssh -e "ssh_disable_dss=True" playbook.yml

echo "Upgrading... "
/usr/bin/nice /usr/bin/ansible-pull --full -d /etc/ansible/ring -U https://github.com/NLNOG/ring-ansible.git --vault-password-file=/root/.vaultpw -i nodes -l {{ ansible_facts['nodename'] }} -c local ubuntu_upgrade.yml

echo "All done. In case of errors, contact a ring admin."
