# {{ ansible_managed }}
smtp_address_preference = {{ postfix_smtp_address_preference }}
myorigin = {{ inventory_hostname }}
alias_maps = hash:/etc/aliases
{% if postfix_sender_address | d() %}
sender_canonical_classes = envelope_sender, header_sender
sender_canonical_maps = static:{{ postfix_sender_address }}
{% endif %}
smtp_reply_filter = pcre:/etc/postfix/smtp_reply_filter
{% if postfix_home_mailbox | d() %}
home_mailbox = {{ postfix_home_mailbox }}
{% endif %}
mynetworks = 127.0.0.0/8 [::1]/128
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
{% if postfix_relayhost | d() and postfix_relay_username | d() %}
relayhost = [{{ postfix_relayhost }}]:{{ postfix_relayhost_port }}
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
{% endif %}
